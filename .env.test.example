# Copy to .env.test for local-only testing. These are placeholders, not usable credentials.
# Never commit a real .env file.
NODE_ENV=test
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-supabase-anon-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-supabase-anon-key
# Keep secret keys server-only. Use only the local Supabase-generated value.
SUPABASE_SECRET_KEY=replace-with-local-supabase-service-role-key
AI_BASE_URL=http://127.0.0.1:4010/v1
AI_API_KEY=test-only-placeholder
AI_MODEL=mock-model
PUBLIC_APP_URL=http://127.0.0.1:3000
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
XHS_CLIENT_ID=
XHS_CLIENT_SECRET=
